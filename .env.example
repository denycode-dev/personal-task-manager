# ==============================================================================
# PERSONAL TASK MANAGER - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to .env and fill in your actual configuration values.
# NEVER commit your actual .env file with production secrets to version control!

# ------------------------------------------------------------------------------
# 1. Application Authentication
# ------------------------------------------------------------------------------
# Global master password required to log into the application (single-user model)
APP_PASSWORD=your_secure_app_password_here

# 32+ character random secret string used to sign JWT session tokens
# You can generate one with: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long

# Master encryption key used in envelope encryption (AES-256-GCM) for locked notes
# You can generate one with: openssl rand -hex 32
NOTE_MASTER_ENCRYPTION_KEY=your_master_encryption_key_32_hex_chars

# ------------------------------------------------------------------------------
# 2. Database Connection (PostgreSQL / Neon Serverless)
# ------------------------------------------------------------------------------
# Connection string to your PostgreSQL instance (supports Neon, Supabase, Local PG)
# Example (Neon): postgresql://user:password@ep-cool-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/personal_task_manager

# ------------------------------------------------------------------------------
# 3. ImageKit Storage Configuration (File & Image Uploads)
# ------------------------------------------------------------------------------
# Obtain these credentials from your ImageKit.io Dashboard (https://imagekit.io)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Max upload file size in bytes (Default: 5242880 = 5MB)
MAX_FILE_SIZE_BYTES=5242880

# ------------------------------------------------------------------------------
# 4. Public URLs
# ------------------------------------------------------------------------------
# Base URL for the running application (used for generating absolute URLs / public share links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
